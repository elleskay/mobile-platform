# NestJS API service env. Nothing loads .env files automatically: export these
# in your shell, or run `node --env-file=.env.local dist/main.js`. Production
# values are GitHub Actions secrets/variables, baked into the Lambda environment
# at synth (docs/DEPLOY.md). Never commit real values.

PORT=3000

# Comma-separated CORS allowlist. Unset => reflect the request origin.
CORS_ORIGIN=

# Postgres (Neon serverless for connection pooling on Lambda)
DATABASE_URL=

# JWT signing for tokens issued to the mobile client
JWT_SECRET=
JWT_ISSUER=mobile-platform

# Report intake queue (SQS). Set from the CDK output after deploy. Unset locally
# makes the service process reports inline instead of enqueuing.
REPORTS_QUEUE_URL=

# OpenSearch for clustering similar reports. Unset => indexing no-ops.
OPENSEARCH_ENDPOINT=

# LLM classifier. Unset => deterministic heuristic fallback.
CLASSIFIER_API_URL=
CLASSIFIER_API_KEY=

# Service name reported by GET /health
DD_SERVICE=mobile-platform-api

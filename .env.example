# Reference for platform-level env vars. Nothing loads this file; production
# values live in GitHub Actions secrets/variables and EAS secrets. The API's
# runtime vars are in services/_template/.env.example.

# AWS (CDK deploy, scripts/connect.sh)
AWS_REGION=ap-southeast-1

# Expo / EAS (mobile build, submit, OTA update)
EXPO_TOKEN=
EAS_PROJECT_ID=

# App build time, read by Expo from apps/<app>/.env.local. EXPO_PUBLIC_* values
# are inlined into the bundle and are public: the API URL is fine, keys are not.
EXPO_PUBLIC_API_URL=
